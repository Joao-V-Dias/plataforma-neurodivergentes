# =============================================================================
# Configuracao de ambiente - copie este arquivo para ".env" e preencha os
# valores reais. NUNCA commite o arquivo ".env" (ja esta no .gitignore).
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
APP_NAME="Plataforma de Educacao Adaptativa"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
# Chave usada para assinar tokens/CSRF em fases futuras (Parte 2). Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-strong-random-secret

# --- CORS ---------------------------------------------------------------------
# Lista separada por virgula das origens do frontend autorizadas
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Banco de dados (PostgreSQL) ----------------------------------------------
POSTGRES_USER=teacher_app
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=teacher_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL assincrona montada a partir das variaveis acima (usada pela aplicacao)
DATABASE_URL=postgresql+asyncpg://teacher_app:changeme-strong-password@db:5432/teacher_platform

# --- Redis ----------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
