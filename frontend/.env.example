# URL base da API do backend (app/main.py, prefixo /api/v1).
# Sem esta variável, o cliente usa http://127.0.0.1:8000/api/v1 como padrão.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# URL do servico de WebSocket de batalhas (battle-service/, na raiz do
# projeto - processo separado da API principal). Sem esta variável, o
# cliente usa ws://127.0.0.1:8001 como padrão.
VITE_BATTLE_WS_URL=ws://127.0.0.1:8001
